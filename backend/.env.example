# backend/.env.example — copy to .env, never commit .env

# Supabase (supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Encryption key for stored credentials
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=your-fernet-key

# Google APIs (v2 - AI Roof Intelligence)
GOOGLE_SOLAR_API_KEY=your-google-solar-api-key
GOOGLE_GEOCODING_KEY=your-google-geocoding-api-key

# WhatsApp via 360dialog (v2 - shared SolarFlow Pro account)
WHATSAPP_360DIALOG_KEY=your-360dialog-api-key
